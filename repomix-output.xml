<file path="client/js/shared/dom.js">
// יוצר אלמנט DOM חדש, מוסיף class, textContent, attributes וילדים.
export const createEl = (tag, options = {}, ...children) => {
    const element = document.createElement(tag);
    const { className, text, attrs = {} } = options;

    if (className) {
        element.className = className;
    }

    if (text !== undefined && text !== null) {
        element.textContent = String(text);
    }

    Object.entries(attrs).forEach(([key, value]) => {
        if (value !== undefined && value !== null && value !== false) {
            element.setAttribute(key, String(value));
        }
    });

    children.forEach((child) => {
        if (child === null || child === undefined || child === false) {
            return;
        }

        if (typeof child === 'string' || typeof child === 'number') {
            element.appendChild(document.createTextNode(String(child)));
            return;
        }

        element.appendChild(child);
    });

    return element;
};

// מרוקן את המשקל ומציג הודעת טעינה עם state loading.
export const showLoading = (container, text = 'טוען...') => {
    if (!container) return;

    container.replaceChildren();
    const paragraph = createEl('p', { className: 'state state-loading', attrs: { role: 'status' } });
    paragraph.textContent = text;
    container.appendChild(paragraph);
};

// מרוקן את המכולה ומציג הודעת שגיאה מהשרת או הודעה כללית.
export const showError = (container, error) => {
    if (!container) return;

    container.replaceChildren();
    const paragraph = createEl('p', { className: 'state state-error', attrs: { role: 'alert' } });
    paragraph.textContent = error?.message || 'משהו השתבש';
    container.appendChild(paragraph);
};

// מרוקן את המכולה ומציג הודעת ריקון למקרה שאין תוצאות.
export const showEmpty = (container, text) => {
    if (!container) return;

    container.replaceChildren();
    const paragraph = createEl('p', { className: 'state state-empty' });
    paragraph.textContent = text;
    container.appendChild(paragraph);
};

// מציג הודעה כללית בראש טופס, ומעדכן את האלמנט אם הוא כבר קיים.
export const showFormError = (form, message) => {
    if (!form) return;

    let errorEl = form.querySelector('.form-error');

    if (!errorEl) {
        errorEl = createEl('div', { className: 'form-error', attrs: { role: 'alert' } });
        form.insertBefore(errorEl, form.firstChild);
    }

    errorEl.textContent = message || '';
    errorEl.hidden = !message;
};

// מציג הודעת שגיאה מתחת לשדה ומציין שהשדה לא תקין.
export const setFieldError = (input, message) => {
    if (!input) return;

    input.setAttribute('aria-invalid', 'true');

    let errorEl = input.parentElement?.querySelector('.field-error');

    if (!errorEl) {
        errorEl = createEl('small', { className: 'field-error' });
        input.insertAdjacentElement('afterend', errorEl);
    }

    errorEl.textContent = message || '';
    errorEl.hidden = !message;
};

// מסיר הודעות שגיאה כלליות, הודעות שדות ו aria-invalid מכל השדות בטופס.
export const clearFormErrors = (form) => {
    if (!form) return;

    const generalError = form.querySelector('.form-error');
    if (generalError) {
        generalError.remove();
    }

    form.querySelectorAll('.field-error').forEach((errorEl) => errorEl.remove());
    form.querySelectorAll('input, select, textarea').forEach((field) => {
        field.removeAttribute('aria-invalid');
    });
};
</file>

<file path="client/js/shared/format.js">
// מחזיר את מפתח היום של השיעור, לפי התאריך UTC שבשדה date.
export const dateKey = (session) => {
    const raw = session?.date ?? '';
    return raw.slice(0, 10);
};

// מחזיר Date לפי התאריך של השיעור והשעה, בשעון המקומי של המשתמש.
export const sessionStart = (session) => {
    const key = dateKey(session);
    const time = session?.time ?? '00:00';
    const [hours, minutes] = String(time).split(':').map((part) => Number(part) || 0);
    const [year, month, day] = key.split('-').map(Number);

    return new Date(year, (month || 1) - 1, day || 1, hours, minutes, 0, 0);
};

// מחזיר true אם תחילת השיעור כבר חצתה את השעה הנוכחית.
export const isPast = (session) => sessionStart(session) < new Date();

// ממיינת עותק חדש של השיעורים מהמהיר למאוחר, בלי לשנות את המערך המקורי.
export const sortSessions = (sessions = []) => {
    return [...sessions].sort((a, b) => sessionStart(a) - sessionStart(b));
};

// מקבצת שיעורים לפי תאריך ומסדרת כל יום לפי השעה.
export const groupByDate = (sessions = []) => {
    const ordered = sortSessions(sessions);
    const grouped = new Map();

    ordered.forEach((session) => {
        const key = dateKey(session);

        if (!grouped.has(key)) {
            grouped.set(key, { date: key, sessions: [] });
        }

        grouped.get(key).sessions.push(session);
    });

    return Array.from(grouped.values());
};

// מחזיר את מפתח היום של היום לפי השעה המקומית של המשתמש.
export const todayKey = () => {
    const now = new Date();
    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
};

// מוסיפה n ימים למפתח יום, כולל ערכים שליליים.
export const addDays = (key, n) => {
    const [year, month, day] = String(key).split('-').map(Number);
    const date = new Date(year, month - 1, day);
    date.setDate(date.getDate() + Number(n || 0));

    const nextYear = date.getFullYear();
    const nextMonth = String(date.getMonth() + 1).padStart(2, '0');
    const nextDay = String(date.getDate()).padStart(2, '0');

    return `${nextYear}-${nextMonth}-${nextDay}`;
};

// מחזיר תאריך עברית ארוך, כגון 'יום שלישי, 27 באוקטובר', עם UTC.
export const formatDateLong = (key) => {
    const [year, month, day] = String(key).split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));

    return new Intl.DateTimeFormat('he-IL', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        timeZone: 'UTC',
    }).format(date);
};

// מחזיר שם של יום בעברית בקצרה, לדוגמה 'שלישי'.
export const formatWeekdayShort = (key) => {
    const [year, month, day] = String(key).split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));

    return new Intl.DateTimeFormat('he-IL', {
        weekday: 'long',
        timeZone: 'UTC',
    }).format(date);
};

// מחזיר את מספר היום בחודש.
export const formatDayOfMonth = (key) => {
    const [year, month, day] = String(key).split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));

    return new Intl.DateTimeFormat('he-IL', {
        day: 'numeric',
        timeZone: 'UTC',
    }).format(date);
};

// ממיר שעת שיעור ל-HH:MM עם אפס מוביל, לדוגמה 9:00 -> 09:00.
export const formatTime = (time) => {
    const [hours = 0, minutes = 0] = String(time ?? '00:00').split(':').map(Number);
    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
};
</file>

<file path="client/js/shared/guard.js">
import { LOGIN_PAGE, CLIENT_HOME, ADMIN_HOME } from '../config.js';
import { isLoggedIn, isAdmin } from './session.js';

// מחייב התחברות ושומר את הכתובת הנוכחית להמשך.
export const requireLogin = () => {
    if (!isLoggedIn()) {
        const next = window.location.pathname + window.location.search;
        window.location.replace(`${LOGIN_PAGE}?next=${encodeURIComponent(next)}`);
        return false;
    }

    return true;
};

// מחייב התחברות והרשאת מנהל.
export const requireAdmin = () => {
    if (!isLoggedIn()) {
        const next = window.location.pathname + window.location.search;
        window.location.replace(`${LOGIN_PAGE}?next=${encodeURIComponent(next)}`);
        return false;
    }

    if (!isAdmin()) {
        window.location.replace(CLIENT_HOME);
        return false;
    }

    return true;
};

// מפנה משתמש מחובר לדף הבית המתאים.
export const redirectIfLoggedIn = () => {
    if (!isLoggedIn()) {
        return false;
    }

    window.location.replace(isAdmin() ? ADMIN_HOME : CLIENT_HOME);
    return true;
};
</file>

<file path="client/js/shared/modal.js">
// מציג חלון אישור עם כותרת, טקסט וכפתורי אישור/ביטול ומחזיר Promise של true/false.
export const confirmDialog = ({ title, text, confirmLabel = 'אישור', cancelLabel = 'ביטול' }) => {
    return new Promise((resolve) => {
        const dialog = document.createElement('dialog');
        dialog.className = 'modal';

        const content = document.createElement('div');
        content.className = 'modal__content';

        const heading = document.createElement('h2');
        heading.className = 'modal__title';
        heading.textContent = title || 'אישור';

        const paragraph = document.createElement('p');
        paragraph.className = 'modal__text';
        paragraph.textContent = text || '';

        const actions = document.createElement('div');
        actions.className = 'modal__actions';

        const cancelButton = document.createElement('button');
        cancelButton.type = 'button';
        cancelButton.className = 'btn btn-secondary';
        cancelButton.textContent = cancelLabel;

        const confirmButton = document.createElement('button');
        confirmButton.type = 'button';
        confirmButton.className = 'btn btn-primary';
        confirmButton.textContent = confirmLabel;

        const close = (value) => {
            dialog.close();
            dialog.remove();
            resolve(value);
        };

        cancelButton.addEventListener('click', () => close(false));
        confirmButton.addEventListener('click', () => close(true));

        dialog.addEventListener('cancel', () => close(false));
        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) {
                close(false);
            }
        });

        actions.append(cancelButton, confirmButton);
        content.append(heading, paragraph, actions);
        dialog.appendChild(content);
        document.body.appendChild(dialog);

        cancelButton.focus();
        dialog.showModal();
    });
};
