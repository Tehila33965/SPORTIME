}

.instructor-avatar {
    width: var(--admin-avatar-size);
    height: var(--admin-avatar-size);
    font-size: var(--admin-avatar-font);
}

.template-cover {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    font-size: 1rem;
}

.instructor-avatar img,
.template-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.instructor-avatar--fallback,
.template-cover--fallback {
    font-size: 1.5rem;
}

.instructor-details,
.template-content,
.admin-session-details {
    min-width: 0;
}

.instructor-title-row,
.admin-session-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
}

.instructor-name,
.template-title {
    margin: 0;
    font-size: var(--admin-title-font);
    font-weight: 700;
    line-height: 1.3;
}

.admin-session-title {
    margin: 0;
    font-size: var(--admin-title-font);
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.instructor-specialization,
.template-category {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.46rem;
    background: var(--admin-lime-soft);
    color: var(--deep);
    border-radius: 999px;
    font-size: var(--admin-tag-font);
    font-weight: 700;
    line-height: 1.3;
}

.instructor-meta,
.template-description,
.admin-session-meta,
.admin-session-attendance,
.session-registered-count {
    color: var(--admin-muted);
}

.admin-session-attendance {
    font-size: 15px;
}

.instructor-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.5rem;
    margin-top: 0.22rem;
    font-size: 15px;
}

.instructor-meta p,
.template-description,
.admin-session-meta,
.session-registered-count {
    margin: 0;
}

.template-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin: 0.2rem 0 0.28rem;
    font-size: 15px;
    line-height: 1.45;
}

.instructor-actions,
.template-actions,
.admin-session-actions,
.form-actions {
    display: flex;
    align-items: center;
    gap: 0.38rem;
}

.instructor-actions,
.template-actions,
.admin-session-actions {
    justify-content: flex-end;
}

.instructor-actions .btn,
.template-actions .btn,
.admin-session-actions .btn,
.form-actions .btn {
    min-height: var(--admin-btn-height);
    padding: var(--admin-btn-padding);
    border-radius: 10px;
}

.admin-panel .btn {
    font-size: var(--admin-btn-font);
}

.admin-form {
    display: grid;
    gap: 1rem;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
}

.field-group {
    display: grid;
}

.field-group--full {
    grid-column: 1 / -1;
}

.image-preview-wrap {
    min-height: 72px;
}

.image-preview {
    display: block;
    width: 100%;
    max-width: 210px;
    height: 120px;
    object-fit: cover;
    border: 1px solid var(--admin-panel-border);
    border-radius: 14px;
    background: #f7f8f6;
}

.schedule-summary {
    margin-bottom: 0.7rem;
}

.schedule-summary-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    background: #fff;
    border: 1px solid #e7ebe3;
    border-radius: 14px;
    box-shadow: 0 2px 12px rgb(17 21 17 / 6%);
    color: var(--deep);
    font-weight: 700;
    font-size: 16px;
}

.checkbox-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1rem;
    font-weight: 600;
    color: var(--muted-strong, var(--muted));
    white-space: nowrap;
}

.checkbox-row input[type='checkbox'] {
    width: 20px;
    height: 20px;
    min-height: 20px;
    flex: 0 0 20px;
    margin: 0;
    accent-color: #9ccb2c;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    font-weight: 600;
    color: var(--muted-strong, var(--muted));
    white-space: nowrap;
}

.schedule-day {
    display: grid;
    gap: 0.45rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid rgb(17 21 17 / 8%);
    /*border-radius: 14px;*/
    background: #fff;
    box-shadow: 0 2px 12px rgb(17 21 17 / 6%);
    border-radius: 12px;
    background: linear-gradient(180deg, rgb(255 255 255 / 85%), rgb(246 249 240 / 98%));
}

.schedule-day-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
}

.schedule-day-rows {
    display: grid;
    gap: 0.42rem;
}

.admin-session-details {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.admin-session-time {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--deep);
    white-space: nowrap;
}

.admin-session-meta {
    font-size: 15px;
    gap: 0.38rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.session-registered-count {
    font-size: 15px;
    white-space: nowrap;
}

.admin-session-status {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    color: #a3491f;
}

.admin-session-status.is-warning {
    color: #8a5b00;
}

.empty-state {
    display: grid;
    gap: 0.45rem;
    padding: 0.7rem;
    border: 1px dashed rgb(17 21 17 / 15%);
    border-radius: 12px;
    background: var(--admin-soft);
}

.empty-state p {
    margin: 0;
    font-size: 16px;
    color: var(--muted-strong, var(--muted));
}

.site-header {
    background-image:
        linear-gradient(180deg, rgba(10, 14, 10, 0.78), rgba(10, 14, 10, 0.9)),
        url("../assets/images/%D7%97%D7%93%D7%A8%20%D7%9B%D7%95%D7%A9%D7%A81.webp");
    background-position: center;
    background-size: cover;
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(255 255 255 / 12%);
}

.site-header a,
.site-header button {
    color: #fff;
}

.site-header .brand {
    color: #fff;
    font-size: 17px;
}

.site-header .brand-mark {
    width: 31px;
    height: 31px;
    color: var(--deep);
    background: var(--lime);
    font-size: 16px;
}

.site-header .main-nav {
    gap: 38px;
    margin-inline-end: 70px;
    font-size: 14px;
}

.site-header .header-cta {
    gap: 10px;
    padding: 10px 16px;
    font-size: 13px;
}

.site-header .main-nav a:hover,
.site-header .text-link:hover {
    color: var(--lime);
}

@media (max-width: 400px) {
    .admin-panel {
        padding: 0;
    }

    .search-row,
    .form-actions,
    .instructor-card,
    .template-card,
    .admin-session-row,
    .admin-session-actions {
        display: grid;
        align-items: stretch;
    }

    .search-row,
    .form-actions,
    .admin-session-actions {
        gap: 0.6rem;
    }

    .search-row {
        grid-template-columns: 1fr;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .instructor-card,
    .template-card,
    .admin-session-row {
        grid-template-columns: 1fr;
        padding: 16px 20px;
    }

    .instructor-card .instructor-avatar,
    .template-cover {
        width: 100%;
        max-width: 100%;
        height: 120px;
        border-radius: 12px;
    }

    .instructor-actions,
    .template-actions,
    .admin-session-actions {
        justify-content: stretch;
    }

    .instructor-actions .btn,
    .template-actions .btn,
    .admin-session-actions .btn,
    .form-actions .btn,
    .search-row .btn {
        width: 100%;
    }

    .checkbox-row {
        white-space: normal;
        line-height: 1.4;
    }
}
