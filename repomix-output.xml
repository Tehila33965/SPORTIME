<file path="server/schemas/registration.schema.js">
import Joi from 'joi';

// שדה ה-user הוסר: המשתמש נקבע בשרת לפי הטוקן.
// Joi דוחה שדות לא מוכרים, ולכן בקשה ששולחת user תקבל 400.
